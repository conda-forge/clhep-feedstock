From 2117fe41a91aea18e0ca388074b3d9efba8faef1 Mon Sep 17 00:00:00 2001
From: Chris Burr <chrisburr73@gmail.com>
Date: Wed, 16 Sep 2026 11:21:32 +0200
Subject: [PATCH] Accept CMake policies up to 3.24

CMake 4 refuses cmake_minimum_required(VERSION 3.2) outright:

  Compatibility with CMake < 3.5 has been removed from CMake.

Upstream fixed this in CLHEP 2.4.5.2 by switching to the <min>...<max>
range form, and carries VERSION 3.2...3.24 from 2.4.5.4 onwards. Backport
that to 2.4.4.0, which Geant4 10.7 requires and which upstream will not
release again.
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3db4438..2ed4742 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -29,7 +29,7 @@ include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/Modules/ClhepOutOfSourceBuild.cmake)
 clhep_ensure_out_of_source_build()
 
 # use cmake 3.2 or later
-cmake_minimum_required(VERSION 3.2)
+cmake_minimum_required(VERSION 3.2...3.24)
 # Project setup
 project(CLHEP VERSION 2.4.4.0)
 # - needed for (temporary) back compatibility
